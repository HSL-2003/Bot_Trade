# ============================================================
# ENVIRONMENT TEMPLATE - COPY THIS FILE TO .env AND FILL IN
# ============================================================
# CRITICAL: NEVER commit your real .env to version control.
# If keys were ever exposed, ROTATE them immediately in the
# Supabase dashboard (Project Settings > API Keys).

# MetaTrader 5 Configuration - Leave empty for simulation mode
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=

# Bot Parameters
MAGIC_NUMBER=20260715
DEFAULT_SYMBOL=XAUUSD
RISK_PERCENT=1.5
MAX_SPREAD=200
MAX_DAILY_LOSS_PERCENT=5.0

# News Filter Config
FOREX_FACTORY_NEWS_URL=https://www.forexfactory.com/ffcal_week_this.xml
NEWS_RESTRICTION_MINUTES=30

# Supabase Configuration - use placeholders only, never real keys
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------
# OAuth Social Login (Google / GitHub via Supabase Auth)
# ------------------------------------------------------------
# Public site URL — used by /api/auth/google & /api/auth/github to build
# the redirect URI: {SITE_URL}/auth/callback
# MUST match "Site URL" + Redirect URLs allow-list in:
# Supabase Dashboard > Authentication > URL Configuration
SITE_URL=http://127.0.0.1:8000
# Providers themselves (Client ID / Secret) are configured in:
# Supabase Dashboard > Authentication > Providers > Google / GitHub
# Callback URL for both providers: https://<project-ref>.supabase.co/auth/v1/callback

# ------------------------------------------------------------
# Security Settings
# ------------------------------------------------------------
# JWT signing secret - generate a random 64+ char string
JWT_SECRET=change-this-to-a-random-64-char-string
# Require authentication on all API endpoints
REQUIRE_AUTH=false
# deployment environment: development | production
ENVIRONMENT=development
# Comma-separated account IDs allowed to act as admins (fallback: role "admin")
ADMIN_ACCOUNT_IDS=

# CORS Settings - comma separated list of allowed origins
ALLOWED_ORIGINS=http://127.0.0.1:8000

# Default trading account id when no session scope is present (dev only)
DEFAULT_ACCOUNT_ID=demo-account

# ------------------------------------------------------------
# Partner / IB analytics (Exness-style estimates on closed lots)
# ------------------------------------------------------------
# Commission USD per 1.0 lot closed
PARTNER_COMMISSION_PER_LOT=5
# Backcom / rebate USD per 1.0 lot (shared back to client pool)
PARTNER_BACKCOM_PER_LOT=1.5
# Platform fee as % of positive bot P&L on each closed trade
PARTNER_PLATFORM_FEE_PCT=10

# SDLC Agents - opt-in only, never enabled by default
ENABLE_SDLC_AGENTS=false