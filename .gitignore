# Heavy 3D models and generated/extracted assets
# Keep these outside Git (store them in release/object storage instead).
static/models/**/*.gltf
static/models/**/*.glb
static/models/**/*.bin
static/models/**/*.obj
static/models/**/*.fbx
static/models/**/*.zip
static/models/**/*.png
static/models/**/*.jpg
static/models/**/*.jpeg
static/models/**/*.webp
static/models/**/textures/

# EXCEPTION: the two hero GLTF models powering the auth pages
# (register: Halo Infinite Master Chief rigged-walk / login: Halo Mk V),
# tracked intentionally so a fresh clone / deployment renders them
# instead of silently falling back to DamagedHelmet.all
!static/models/halo_b_model/**
!static/models/halo_mk_v_model/**


# Runtime artifacts
news_cache.json
trade_history.json

oauth_test.log

